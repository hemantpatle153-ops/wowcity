// Cloudflare Worker: serves the static site from dist/ and handles the Join form (src/worker.js).
// Secrets to add in Cloudflare (Worker → Settings → Variables and Secrets): RESEND_API_KEY, and JOIN_TO
// (where join requests are emailed; kept out of this public repo, defaults to support@luzzan.com).
{
  "name": "wowcity",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Keep variables added in the Cloudflare dashboard when a push redeploys the Worker.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "JOIN_FROM": "WowCity Website <noreply@luzzan.com>"
  },
  "observability": { "enabled": true }
}
